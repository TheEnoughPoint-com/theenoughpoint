---
// Every private district in Singapore on the two things a buyer can check before
// committing: what it costs per square foot, and what it yields in rent.
//
// TWO panels, deliberately: the relationship everyone assumes, beside the one that is
// actually there. Price against yield is flat (Spearman -0.09). Median unit size against
// yield is not (Spearman -0.59). Showing only the first would report a non-finding;
// showing only the second would lose the point that it overturns something.
//
// Two earlier drafts of this component were wrong, which is why it now carries its
// correlations on its face. The first asserted a price/yield trade-off before anyone
// measured it. The second had 20 of 26 rows hand-typed and mostly fabricated. The array
// is now emitted mechanically from the source data and diffed row by row.
//
// Unit size is a volume-weighted mean of project medians, excluding records above
// 10,000 sqft — LOYANG VALLEY carries 626,545 sqft, a land figure rather than a flat,
// and with the weighting it alone moved a district's mean by a factor of five.
//
// Districts are places, not products. Ranking them raises none of the questions that
// ranking named developments would.
//
// Colour marks segment, which is a classification and not a verdict. Blue and amber
// also carry resale/new-build in the entry-gap piece; different article, different
// entities, so no conflict — but worth knowing if the two ever sit on one page.
// Validated on both card surfaces: light #2563EB/#B45309/#7C3AED,
// dark #4E86DD/#B8842E/#9575E0. Every point is labelled with its district code, so
// identity never rests on colour alone.
//
// Snapshot, not a live feed: this site builds statically, so the figures are stamped
// with their as-of date and go stale honestly rather than pretending to be current.
const ASOF = 'July 2026';
const BASIS = 'resale condominiums and apartments, last 12 months, URA caveat data';

interface Row { d: string; name: string; seg: 'CCR' | 'RCR' | 'OCR'; psf: number; vol: number; yld: number; mom: number; size: number }

const ROWS: Row[] = [
  { d: 'D1', name: 'Raffles Place / Marina', seg: 'CCR', psf: 1959, vol: 157, yld: 4.08, mom: -1.8, size: 941 },
  { d: 'D2', name: 'Tanjong Pagar / Anson', seg: 'CCR', psf: 2162, vol: 132, yld: 3.91, mom: 4.8, size: 731 },
  { d: 'D3', name: 'Tiong Bahru / Queenstown', seg: 'RCR', psf: 2250, vol: 550, yld: 3.49, mom: 3.1, size: 863 },
  { d: 'D4', name: 'Sentosa / Harbourfront', seg: 'RCR', psf: 1774, vol: 258, yld: 3.68, mom: 0.7, size: 1675 },
  { d: 'D5', name: 'Buona Vista / Clementi / Dover', seg: 'OCR', psf: 1873, vol: 772, yld: 3.57, mom: 7.8, size: 967 },
  { d: 'D7', name: 'Bugis / Beach Road', seg: 'RCR', psf: 2126, vol: 121, yld: 4.06, mom: 4.3, size: 904 },
  { d: 'D8', name: 'Little India / Farrer Park', seg: 'RCR', psf: 1765, vol: 173, yld: 3.83, mom: 0.2, size: 923 },
  { d: 'D9', name: 'Orchard / River Valley', seg: 'CCR', psf: 2330, vol: 679, yld: 3.09, mom: 2.6, size: 1263 },
  { d: 'D10', name: 'Bukit Timah / Holland', seg: 'CCR', psf: 2239, vol: 836, yld: 2.8, mom: 1.1, size: 1561 },
  { d: 'D11', name: 'Novena / Newton', seg: 'CCR', psf: 2049, vol: 338, yld: 2.83, mom: 1.2, size: 1322 },
  { d: 'D12', name: 'Balestier / Toa Payoh', seg: 'RCR', psf: 1741, vol: 359, yld: 3.45, mom: 2.7, size: 923 },
  { d: 'D13', name: 'Macpherson / Potong Pasir', seg: 'RCR', psf: 1992, vol: 302, yld: 3.43, mom: 4.0, size: 808 },
  { d: 'D14', name: 'Geylang / Eunos', seg: 'RCR', psf: 1697, vol: 622, yld: 3.83, mom: -2.0, size: 875 },
  { d: 'D15', name: 'East Coast / Marine Parade', seg: 'RCR', psf: 1833, vol: 947, yld: 3.03, mom: 2.7, size: 1259 },
  { d: 'D16', name: 'Bedok / Upper East Coast', seg: 'OCR', psf: 1526, vol: 572, yld: 3.33, mom: 0.6, size: 1083 },
  { d: 'D17', name: 'Changi / Loyang', seg: 'OCR', psf: 1255, vol: 261, yld: 3.37, mom: 3.0, size: 1026 },
  { d: 'D18', name: 'Tampines / Pasir Ris', seg: 'OCR', psf: 1492, vol: 756, yld: 3.45, mom: -0.2, size: 981 },
  { d: 'D19', name: 'Serangoon / Hougang / Punggol', seg: 'OCR', psf: 1691, vol: 1308, yld: 3.28, mom: 5.8, size: 915 },
  { d: 'D20', name: 'Bishan / Ang Mo Kio', seg: 'RCR', psf: 1962, vol: 376, yld: 2.84, mom: 5.0, size: 1134 },
  { d: 'D21', name: 'Upper Bukit Timah / Clementi Pk', seg: 'RCR', psf: 1805, vol: 421, yld: 2.66, mom: 8.6, size: 1206 },
  { d: 'D22', name: 'Jurong', seg: 'OCR', psf: 1614, vol: 272, yld: 3.52, mom: 3.1, size: 1086 },
  { d: 'D23', name: 'Bukit Batok / Choa Chu Kang', seg: 'OCR', psf: 1490, vol: 614, yld: 3.26, mom: 6.4, size: 1029 },
  { d: 'D25', name: 'Woodlands / Kranji', seg: 'OCR', psf: 1153, vol: 92, yld: 3.89, mom: -3.7, size: 935 },
  { d: 'D26', name: 'Upper Thomson / Mandai', seg: 'OCR', psf: 1502, vol: 76, yld: 2.95, mom: 3.5, size: 1191 },
  { d: 'D27', name: 'Sembawang / Yishun', seg: 'OCR', psf: 1301, vol: 296, yld: 3.77, mom: 3.4, size: 1031 },
  { d: 'D28', name: 'Seletar / Yio Chu Kang', seg: 'OCR', psf: 1548, vol: 218, yld: 3.19, mom: 2.7, size: 920 },
];

// Axis bounds are round numbers just outside the data, so no point sits on an edge.
const X0 = 1100, X1 = 2400, Y0 = 2.5, Y1 = 4.2;
const px = (v: number) => ((v - X0) / (X1 - X0)) * 100;
const py = (v: number) => 100 - ((v - Y0) / (Y1 - Y0)) * 100;

const XT = [1100, 1400, 1700, 2000, 2300];
const YT = [2.5, 3.0, 3.5, 4.0];
// second panel: median unit size
const S0 = 650, S1 = 1750;
const sx = (v: number) => ((v - S0) / (S1 - S0)) * 100;
const ST = [700, 1000, 1300, 1600];
const SEGS = [
  { k: 'OCR', label: 'Outside central' },
  { k: 'RCR', label: 'Rest of central' },
  { k: 'CCR', label: 'Core central' },
];
const byPsf = [...ROWS].sort((a, b) => a.psf - b.psf);
---

<figure class="dy">
  <figcaption class="dy-cap">
    <h4>Price does not predict yield. Unit size does.</h4>
    <p>Every private district, plotted twice. On the left, the relationship everyone assumes.
    On the right, the one that is actually there. {BASIS}, as at {ASOF}.</p>
  </figcaption>

  <div class="dy-legend">
    {SEGS.map((s) => (
      <span class="dy-lg"><i class={`dy-dot ${s.k}`}></i>{s.label}</span>
    ))}
    <span class="dy-hint">if price predicted yield, these would form a line — they do not</span>
  </div>

  <div class="dy-panels" data-dywrap>
    <div class="dy-tip" data-dytip hidden>
      <b data-tip-head></b>
      <span data-tip-seg></span>
      <dl>
        <div><dt>Price</dt><dd data-tip-psf></dd></div>
        <div><dt>Gross yield</dt><dd data-tip-yld></dd></div>
        <div><dt>Median size</dt><dd data-tip-size></dd></div>
        <div><dt>Resales, 12m</dt><dd data-tip-vol></dd></div>
      </dl>
    </div>
    <div class="dy-panel">
      <div class="dy-ptitle">Median price per sq ft <em>cheap half 3.45% &middot; dear half 3.36%</em></div>
      <div class="dy-plotwrap">
        <div class="dy-ylab">Gross yield</div>
        <div class="dy-plot">
          {YT.map((t) => (<div class="dy-grid-y" style={`top:${py(t)}%`}><span>{t.toFixed(1)}%</span></div>))}
          {XT.map((t) => (<div class="dy-grid-x" style={`left:${px(t)}%`}><span>${(t / 1000).toFixed(1)}k</span></div>))}
          {ROWS.map((r) => (
            <div class={`dy-pt ${r.seg}`} style={`left:${px(r.psf)}%;top:${py(r.yld)}%`}
                 tabindex="0" role="img" data-tip
                 data-d={r.d} data-name={r.name} data-seg={r.seg}
                 data-psf={r.psf} data-yld={r.yld.toFixed(2)} data-size={r.size} data-vol={r.vol}
                 aria-label={`${r.d} ${r.name}, ${r.seg}. $${r.psf.toLocaleString('en-SG')} per square foot, ${r.yld.toFixed(2)} per cent gross yield, median ${r.size} square feet, ${r.vol} resales.`}>
              <span class="dy-plab">{r.d}</span>
            </div>
          ))}
        </div>
        <div class="dy-xlab">Price per square foot &rarr;</div>
      </div>
    </div>

    <div class="dy-panel">
      <div class="dy-ptitle">Median unit size <em class="hit">small-flat half 3.58% &middot; big-flat half 3.23%</em></div>
      <div class="dy-plotwrap">
        <div class="dy-ylab">Gross yield</div>
        <div class="dy-plot">
          {YT.map((t) => (<div class="dy-grid-y" style={`top:${py(t)}%`}><span>{t.toFixed(1)}%</span></div>))}
          {ST.map((t) => (<div class="dy-grid-x" style={`left:${sx(t)}%`}><span>{t.toLocaleString('en-SG')}</span></div>))}
          {ROWS.map((r) => (
            <div class={`dy-pt ${r.seg}`} style={`left:${sx(r.size)}%;top:${py(r.yld)}%`}
                 tabindex="0" role="img" data-tip
                 data-d={r.d} data-name={r.name} data-seg={r.seg}
                 data-psf={r.psf} data-yld={r.yld.toFixed(2)} data-size={r.size} data-vol={r.vol}
                 aria-label={`${r.d} ${r.name}, ${r.seg}. $${r.psf.toLocaleString('en-SG')} per square foot, ${r.yld.toFixed(2)} per cent gross yield, median ${r.size} square feet, ${r.vol} resales.`}>
              <span class="dy-plab">{r.d}</span>
            </div>
          ))}
        </div>
        <div class="dy-xlab">Median unit size, sq ft &rarr;</div>
      </div>
    </div>
  </div>

  <p class="dy-foot">Split the districts in half by price and the two halves yield almost the same: 3.45% against 3.36%. Split them by the size of the flats instead and the gap is <b>nearly four times wider</b>. Districts of small flats yield more; districts of family-sized homes yield less &mdash; which is most of what a district-level yield is actually measuring. Yield is gross, before maintenance, tax and vacancy.</p>

  <div class="dy-scroll">
    <table class="dy-table">
      <thead>
        <tr><th>District</th><th>Segment</th><th>Median $psf</th><th>Gross yield</th><th>Median size</th><th>Resales, 12m</th></tr>
      </thead>
      <tbody>
        {byPsf.map((r) => (
          <tr>
            <td><b>{r.d}</b> {r.name}</td>
            <td>{r.seg}</td>
            <td>${r.psf.toLocaleString('en-SG')}</td>
            <td>{r.yld.toFixed(2)}%</td>
            <td>{r.size.toLocaleString('en-SG')} sqft</td>
            <td>{r.vol.toLocaleString('en-SG')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="dy-src">Median resale price and transaction counts computed by us from URA caveat
  data, {BASIS}. Gross yield is the district's median resale rent over its median resale
  price, <b>unadjusted for unit size</b> — small units rent for more per square foot, so a
  district holding more of them will show a higher yield for that reason alone. That is the
  main caveat on any district-level yield, including this one. Districts 6 and 24 are absent because too few private resales occur there to give a
  meaningful median.</p>
</figure>

<style is:global>
.dy{
  --dy-ocr:#2563EB; --dy-rcr:#B45309; --dy-ccr:#7C3AED;   /* validated triple, light card */
  --dy-rule:var(--color-border); --dy-ink:var(--color-dark);
  --dy-body:var(--color-body); --dy-muted:var(--color-muted);
  --dy-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  margin:26px 0;padding:20px 22px 16px;background:#fff;
  border:1px solid var(--dy-rule);border-radius:12px
}
/* No dark-scheme colour swap. The card sets background:#fff unconditionally,
   so a dark-mode block that lightens the ink puts pale text on a white card.
   The triple this replaced measured 3.63:1, 3.29:1 and 3.56:1 there. Every
   colour here is measured against white — #2563EB 5.17:1, #B45309 5.02:1,
   #7C3AED 5.70:1 — and stays put. */
.post-content .dy-cap{margin:0 0 14px;padding:0;text-align:left}
.post-content .dy-cap h4{margin:0 0 3px;font-size:15.5px;font-weight:700;color:var(--dy-ink);
  font-family:var(--font-body);letter-spacing:0}
.post-content .dy-cap p{margin:0;font-size:12.5px;color:var(--dy-muted);line-height:1.5}

.dy-legend{display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;margin-bottom:14px;font-size:11.5px}
.dy-lg{display:flex;align-items:center;gap:6px;color:var(--dy-body)}
.dy-dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.dy-dot.OCR{background:var(--dy-ocr)} .dy-dot.RCR{background:var(--dy-rcr)} .dy-dot.CCR{background:var(--dy-ccr)}
.dy-hint{color:var(--dy-muted);font-style:italic}

.dy-panels{display:grid;grid-template-columns:1fr 1fr;gap:20px;position:relative}
.dy-tip{position:absolute;z-index:5;pointer-events:none;min-width:172px;
  background:var(--dy-ink);color:#fff;border-radius:8px;padding:9px 11px;
  box-shadow:0 6px 18px rgba(0,0,0,.22);font-size:11.5px;line-height:1.4;
  transform:translate(-50%,calc(-100% - 14px))}
.dy-tip b{display:block;font-size:12.5px;font-weight:700}
.dy-tip > span{display:block;opacity:.7;margin-bottom:6px}
.dy-tip dl{margin:0;display:grid;gap:2px}
.dy-tip dl div{display:flex;justify-content:space-between;gap:14px}
.dy-tip dt{opacity:.7}
.dy-tip dd{margin:0;font-family:var(--dy-mono);font-variant-numeric:tabular-nums;font-weight:600}
/* the arrow, so the tooltip reads as attached to its point rather than floating */
.dy-tip::after{content:"";position:absolute;left:50%;bottom:-5px;width:10px;height:10px;
  background:var(--dy-ink);transform:translateX(-50%) rotate(45deg)}
.dy-panel{min-width:0}
.dy-ptitle{font-size:11px;font-weight:700;color:var(--dy-ink);margin-bottom:8px;
  display:flex;flex-wrap:wrap;gap:6px;align-items:baseline}
.dy-ptitle em{font-style:normal;font-weight:600;font-size:10.5px;color:var(--dy-muted);
  font-family:var(--dy-mono);border:1px solid var(--dy-rule);border-radius:999px;padding:1px 7px}
.dy-ptitle em.hit{color:var(--dy-ink);border-color:var(--dy-ink)}
@media(max-width:700px){ .dy-panels{grid-template-columns:1fr;gap:26px} }

.dy-plotwrap{display:grid;grid-template-columns:18px 1fr;grid-template-rows:1fr 22px;gap:6px}
.dy-ylab{grid-column:1;grid-row:1;writing-mode:vertical-rl;transform:rotate(180deg);
  font-size:10.5px;color:var(--dy-muted);justify-self:center;align-self:center;letter-spacing:.04em}
.dy-xlab{grid-column:2;grid-row:2;text-align:center;font-size:10.5px;color:var(--dy-muted);letter-spacing:.04em}
.dy-plot{grid-column:2;grid-row:1;position:relative;height:270px;
  border-left:1px solid var(--dy-rule);border-bottom:1px solid var(--dy-rule)}

.dy-grid-y{position:absolute;left:0;right:0;height:0;border-top:1px dashed var(--dy-rule);opacity:.7}
.dy-grid-y span{position:absolute;left:-4px;top:-7px;transform:translateX(-100%);
  font-size:10px;color:var(--dy-muted);font-family:var(--dy-mono)}
.dy-grid-x{position:absolute;top:0;bottom:0;width:0;border-left:1px dashed var(--dy-rule);opacity:.7}
.dy-grid-x span{position:absolute;bottom:-17px;left:0;transform:translateX(-50%);
  font-size:10px;color:var(--dy-muted);font-family:var(--dy-mono);white-space:nowrap}

/* the dot is the mark; the code beside it is the secondary encoding, so identity
   never depends on being able to tell the three hues apart */
.dy-pt{position:absolute;width:11px;height:11px;border-radius:50%;
  transform:translate(-50%,-50%);border:1.5px solid #fff;cursor:pointer;
  transition:transform .12s ease}
.dy-pt:hover,.dy-pt:focus-visible{transform:translate(-50%,-50%) scale(1.55);z-index:4;outline:none}
.dy-pt:focus-visible{box-shadow:0 0 0 3px rgba(37,99,235,.45)}
@media(prefers-reduced-motion:reduce){ .dy-pt{transition:none} }
.dy-pt.OCR{background:var(--dy-ocr)} .dy-pt.RCR{background:var(--dy-rcr)} .dy-pt.CCR{background:var(--dy-ccr)}
.dy-plab{position:absolute;left:13px;top:-5px;font-size:9.5px;font-weight:700;
  color:var(--dy-ink);font-family:var(--dy-mono);white-space:nowrap;pointer-events:none}

.post-content .dy-foot{font-size:13.5px;color:var(--dy-body);line-height:1.6;margin:26px 0 0}
.dy-scroll{overflow-x:auto;margin-top:14px}
.post-content table.dy-table{width:100%;border-collapse:collapse;font-size:13px;margin:0;min-width:520px}
.post-content .dy-table th{font-size:10px;letter-spacing:.05em;text-transform:uppercase;
  color:var(--dy-muted);font-weight:700;background:none;padding:0 9px 6px 0;
  border-bottom:1px solid var(--dy-rule);text-align:left}
.post-content .dy-table th:not(:first-child),
.post-content .dy-table td:not(:first-child){text-align:right;font-family:var(--dy-mono);
  font-variant-numeric:tabular-nums}
.post-content .dy-table td{padding:6px 9px 6px 0;border-bottom:1px solid var(--dy-rule);color:var(--dy-body)}
.post-content .dy-table td b{color:var(--dy-ink)}
.post-content .dy-table tr:last-child td{border-bottom:none}
.post-content .dy-note{font-size:11.5px;color:var(--dy-muted);line-height:1.55;margin:10px 0 0}
.post-content .dy-src{font-size:11.5px;color:var(--dy-muted);line-height:1.55;margin:12px 0 0}

@media(max-width:600px){
  .dy{padding:16px 12px 13px}
  .dy-plot{height:250px}
  .dy-plab{font-size:8.5px;left:11px}
  .dy-pt{width:9px;height:9px}
}
</style>

<script is:inline>
  (function () {
    var wrap = document.querySelector('[data-dywrap]');
    if (!wrap) return;
    var tip = wrap.querySelector('[data-dytip]');
    var f = function (n) { return Number(n).toLocaleString('en-SG'); };
    var SEG = { OCR: 'Outside central', RCR: 'Rest of central', CCR: 'Core central' };

    function show(pt) {
      var d = pt.dataset;
      tip.querySelector('[data-tip-head]').textContent = d.d + ' · ' + d.name;
      tip.querySelector('[data-tip-seg]').textContent = SEG[d.seg] || d.seg;
      tip.querySelector('[data-tip-psf]').textContent = '$' + f(d.psf) + ' psf';
      tip.querySelector('[data-tip-yld]').textContent = d.yld + '%';
      tip.querySelector('[data-tip-size]').textContent = f(d.size) + ' sqft';
      tip.querySelector('[data-tip-vol]').textContent = f(d.vol);
      tip.hidden = false;
      // position against the wrapper, then pull it back inside if it would overhang
      var w = wrap.getBoundingClientRect(), r = pt.getBoundingClientRect();
      var x = r.left - w.left + r.width / 2, y = r.top - w.top;
      tip.style.left = '0px'; tip.style.top = '0px';
      var tw = tip.getBoundingClientRect().width;
      var min = tw / 2 + 4, max = w.width - tw / 2 - 4;
      tip.style.left = Math.max(min, Math.min(max, x)) + 'px';
      tip.style.top = y + 'px';
    }
    function hide() { tip.hidden = true; }

    wrap.querySelectorAll('[data-tip]').forEach(function (pt) {
      pt.addEventListener('mouseenter', function () { show(pt); });
      pt.addEventListener('focus', function () { show(pt); });
      pt.addEventListener('mouseleave', hide);
      pt.addEventListener('blur', hide);
    });
    wrap.addEventListener('mouseleave', hide);
  })();
</script>
