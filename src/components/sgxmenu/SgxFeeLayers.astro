  .fee-map .fee-map-fund{margin-top:5px;font-size:13px}
  .fee-map dl{margin:12px 0 0}
  .fee-map dl>div{padding:10px 0;border-bottom:1px solid var(--color-border)}
  .fee-map dt{font-size:14px;font-weight:600;line-height:1.5}
  .fee-map dd{font-size:16px;line-height:1.5;font-weight:700;color:var(--color-dark);margin:4px 0 0}
  .fee-map .fee-map-subtotal{border-top:2px solid var(--color-muted)}
  .fee-map .fee-map-source{font-size:13px;color:var(--color-muted);margin-top:14px}
  .fee-map .fee-map-caution{border-left:3px solid var(--color-muted);padding-left:12px;margin-top:18px}
  @media(max-width:640px){.fee-map-grid{grid-template-columns:1fr;gap:22px}}
</style>
