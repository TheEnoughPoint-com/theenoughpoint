---
// Explainer: published holdings, fund fees and practical access.
// No projection of all-in route costs or recommendation of a cheaper exchange.
import { Font } from 'astro:assets';
import ToolBrand from '../ToolBrand.astro';

---

<Font cssVariable="--font-mono" />

<div class="sm" data-card="tool">
  <div class="sm-head">
    <span class="sm-lbl">Eight new ETFs on SGX</span>
    <span class="sm-lbl accent card-live">Interactive</span>
  </div>

  <div class="sm-body">
    <p class="sm-hint"><b>Choose the market first, then the way to buy it.</b> The four direct Xtrackers listings have no extra Singapore fund layer. The four iFAST funds add a fund layer for local access to Japan, Korea, Taiwan or an AI theme. These are different investments, not cheaper and dearer versions of the same portfolio.</p>
  </div>

  <div class="sm-tabs" role="tablist" aria-label="Choose a view">
    <button type="button" class="sm-tab" id="sm-tab-own" role="tab" aria-selected="true" aria-controls="sm-own">What you own</button>
    <button type="button" class="sm-tab" id="sm-tab-cost" role="tab" aria-selected="false" aria-controls="sm-cost">Fees and access</button>
  </div>

  <!-- ============ What you own ============ -->
  <section id="sm-own" role="tabpanel" aria-labelledby="sm-tab-own">
    <div class="sm-body">
      <p class="sm-hint">Enter what you hold or plan to hold in each fund, in Singapore dollars. Equal
      amounts are filled in as a hypothetical example, not a suggested portfolio. Leave a fund at 0 to exclude it. For direct listings, the fee covers one fund. For iFAST, the published total expense ratio (TER) estimates cover both fund layers: do not add the overseas fee again. These estimates are not guaranteed caps.</p>
      <div class="sm-tblwrap">
        <table class="sm-tbl" id="sm-own-tbl">
          <thead><tr><th>Fund</th><th>Fund fee a year</th><th>Amount S$</th></tr></thead>
          <tbody><!-- rows injected, fixed order --></tbody>
        </table>
      </div>
    </div>
    <div class="sm-bars-wrap">
      <div class="sm-bars-t" id="sm-own-t">&mdash;</div>
      <div class="sm-bars" id="sm-own-bars"></div>
    </div>
    <div class="sm-out"><div class="sm-out-s" id="sm-own-say">&mdash;</div></div>
  </section>

  <!-- ============ What it costs ============ -->
  <section id="sm-cost" role="tabpanel" aria-labelledby="sm-tab-cost" hidden>
    <div class="sm-body">
      <p class="sm-hint">Published annual fund charges only, not all-in ownership costs. Broker charges, live spreads, taxes and fund-level trading or currency friction are not projected.</p>
      <div class="sm-top">
        <label class="sm-f">
          <span>Market or theme</span>
          <select id="sm-exp" class="sm-sel" aria-label="Market or theme">
            <option value="XUS">S&amp;P 500</option>
            <option value="XWR">MSCI World</option>
            <option value="XND">Nasdaq-100</option>
            <option value="EUS">S&amp;P 500 Equal Weight</option>
            <option value="TWD">MSCI Taiwan</option>
            <option value="KOR">MSCI Korea</option>
            <option value="JPY">Nikkei 225</option>
            <option value="XBG">AI &amp; Big Data</option>
          </select>
        </label>
      </div>
      <div id="sm-fee-details" aria-live="polite"></div>
      <p class="sm-hint">DWS fees: 30 September 2026. iFAST publisher TER figures: Japan/AI, 30 September 2026; Korea/Taiwan, 29 September 2026. These pre-launch TERs are estimates, not caps; their component reconciliation is not supplied. Links are in Sources and verification.</p>
    </div>
  </section>

  <div class="sm-notes">
    <details class="sm-more">
      <summary>How this is calculated</summary>
      <p><b>What you own.</b> Each company&rsquo;s share of your total = the sum over your lines of
      (amount in the line &times; the company&rsquo;s weight in that fund) &divide; your total. Weights are the
      funds&rsquo; published top-ten holdings at 30 September 2026 (DWS factsheets); a company outside a
      fund&rsquo;s top ten counts as zero there, so true figures can be slightly higher. The equal-weight
      fund holds about 500 names at roughly 0.2% each, taken as 0.2% for the US names shown. Samsung
      Electronics includes its preference shares. The combined fee weights each line&rsquo;s annual fund
      charge by amount. All four iFAST funds use FSM Global&rsquo;s published pre-launch TER figures: Japan/AI at 30 September 2026 and Korea/Taiwan at 29 September 2026. These are estimates, not caps.</p>
      <p><b>Fees and access.</b> Annual fee disclosures are shown separately for each legal fund. For iFAST, the published TER is used once; its underlying fund fee is not added again. The ownership view weights disclosed annual fees by your entered amounts. Neither view estimates all-in costs or future returns.</p>
    </details>
    <p><b>What this is not.</b> Advice or a ranking. Lines and routes stay in a fixed order; the numbers are
    published holdings and fee disclosures, including labelled publisher estimates.</p>
    <ToolBrand />
  </div>
</div>

<style is:global>
.sm{
  --sm-bg2:var(--color-surface); --sm-bd:var(--color-border); --sm-bd2:#D5CDBB;
  --sm-t1:var(--color-dark); --sm-t2:var(--color-body); --sm-t3:var(--color-muted);
  --sm-g:var(--color-brand-600); --sm-g2:var(--color-brand-700);
  --sm-deep:var(--color-navy);
  --sm-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  background:#fff;border:1px solid var(--sm-bd);border-radius:12px;
  box-shadow:0 4px 6px rgba(0,0,0,.05),0 2px 4px rgba(0,0,0,.04);
  overflow:hidden;margin:26px 0;font-size:16px;line-height:1.6;color:var(--sm-t1)
}
.sm .num{font-family:var(--sm-mono);font-variant-numeric:tabular-nums}
.sm-head{padding:14px 22px;background:var(--sm-bg2);border-bottom:1px solid var(--sm-bd);
  display:flex;justify-content:space-between;align-items:center;gap:12px}
.sm-lbl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--sm-t3)}
.sm-lbl.accent{color:var(--sm-g2)}
.sm-tabs{display:flex;gap:0;border-bottom:1px solid var(--sm-bd);background:#fff}
.sm-tab{flex:1;font-size:14px;font-weight:700;padding:11px 10px;border:none;background:none;cursor:pointer;
  color:var(--sm-t3);border-bottom:3px solid transparent}
.sm-tab[aria-selected="true"]{color:var(--sm-deep);border-bottom-color:var(--sm-deep)}
.sm-tab:focus-visible{outline:2px solid var(--sm-g);outline-offset:-2px}
.sm-body{padding:16px 22px 8px}
.post-content .sm-hint{font-size:12.5px;color:var(--sm-t3);line-height:1.5;margin:0 0 10px}
.sm-top{display:flex;gap:14px 34px;flex-wrap:wrap;margin-bottom:12px}
.sm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:10px 24px;margin:4px 0 12px}
.sm-f{display:flex;align-items:baseline;gap:10px;margin:0;flex-wrap:wrap}
.sm-f > span:first-child{font-size:14px;color:var(--sm-t2)}
.sm-in{display:inline-flex;align-items:baseline;font-family:var(--sm-mono);font-size:15px;font-weight:600}
.sm-in i{font-style:normal;color:var(--sm-t3);font-size:13px;margin:0 3px}
.sm-in input{font-family:var(--sm-mono);font-size:15px;font-weight:600;color:var(--sm-t1);
  background:none;border:none;border-bottom:1px dashed var(--sm-bd2);text-align:right;
  width:5ch;padding:0 0 1px}
.sm-in input.w-lg{width:9ch}
.sm-sel{font-family:var(--font-body);font-size:14px;font-weight:600;color:var(--sm-t1);background:#fff;
  border:1px solid var(--sm-bd2);border-radius:8px;padding:4px 8px}
.sm-in input:focus,.sm-tbl input:focus,.sm-sel:focus{outline:none;border-color:var(--sm-g);color:var(--sm-g2);box-shadow:none}
.sm-acct{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:4px 0 12px}
.sm-acct-l{font-size:14px;color:var(--sm-t2);margin-right:4px}
.sm-pill{font-size:13px;font-weight:600;padding:5px 14px;border-radius:999px;cursor:pointer;
  border:1px solid var(--sm-bd2);background:#fff;color:var(--sm-t2)}
.sm-pill[aria-checked="true"]{background:var(--sm-deep);border-color:var(--sm-deep);color:#fff}
.sm-pill:focus-visible{outline:2px solid var(--sm-g);outline-offset:2px}
.sm-more{margin:0 0 10px}
.sm-more summary{cursor:pointer;font-size:13px;font-weight:600;color:var(--sm-g2);padding:4px 0}
.sm-tblwrap{overflow-x:auto}
.post-content .sm-tbl{width:100%;border-collapse:collapse;font-size:13.5px;margin:0 0 8px}
.post-content .sm-tbl th{font-size:11px;text-transform:uppercase;letter-spacing:.7px;
  color:#C9D3E0;font-weight:700;text-align:right;padding:7px 8px;border-bottom:1px solid var(--sm-bd)}
.post-content .sm-tbl th:first-child{text-align:left;color:#fff}
.post-content .sm-tbl td{padding:8px;border-bottom:1px dashed var(--sm-bd);vertical-align:top;text-align:right}
.post-content .sm-tbl td:first-child{text-align:left;color:var(--sm-t2);line-height:1.35}
.sm-tbl td em{display:block;font-style:normal;font-size:11px;color:var(--sm-t3);margin-top:2px}
.sm-tbl input{font-family:var(--sm-mono);font-size:14px;font-weight:600;color:var(--sm-t1);
  background:none;border:none;border-bottom:1px dashed var(--sm-bd2);text-align:right;width:8ch;padding:0 0 1px}
.sm-tbl input.w-sm{width:5ch}

.sm-bars-wrap{padding:14px 22px 18px;border-top:1px solid var(--sm-bd)}
.sm-bars-t{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--sm-t3);margin-bottom:12px}
.sm-bars-t b{color:#7A5A1D}
.sm-bars{display:flex;flex-direction:column;gap:14px}
.sm-bar-l{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:5px;flex-wrap:wrap}
.sm-bar-l span{font-size:13.5px;color:var(--sm-t2)}
.sm-bar-l b{font-family:var(--sm-mono);font-size:15px;font-weight:600;color:var(--sm-t1)}
.sm-tc{font-style:normal;font-family:var(--font-body);font-size:11px;font-weight:600;color:var(--sm-t3);margin-left:4px}
.sm-track{height:10px;background:var(--color-surface-alt);border-radius:999px;overflow:hidden}
.sm-fill{height:100%;border-radius:999px;transition:width .3s ease;min-width:2px;background:#9C7526}
.sm-sub{font-size:12.5px;color:var(--sm-t2);margin-top:5px}
.sm-sub b{font-family:var(--sm-mono);font-weight:600;color:var(--sm-t1)}
.sm-bar.off .sm-bar-l span{color:var(--sm-t3)}
.sm-offnote{font-size:12.5px;color:var(--sm-t3)}

.sm-out{background:var(--sm-deep);color:#fff;padding:17px 22px}
.sm-out-s{font-size:15px;line-height:1.6;color:#D8DEE8}
.sm-out-s b{font-family:var(--sm-mono);font-weight:600;color:#fff}

.sm-notes{padding:15px 22px 17px;border-top:1px solid var(--sm-bd);background:var(--sm-bg2)}
.post-content .sm-notes p{font-size:12.5px;line-height:1.55;color:var(--sm-t3);margin:0 0 7px}
.post-content .sm-notes p:last-child{margin-bottom:0}
.sm-notes b{color:var(--sm-t2)}
@media(max-width:640px){ .sm-head,.sm-body,.sm-bars-wrap,.sm-out,.sm-notes{padding-left:16px;padding-right:16px} }
@media(prefers-reduced-motion:reduce){.sm *{transition:none!important}}
.post-content #sm-fee-details h3{font-size:17px;margin:12px 0}
.post-content #sm-fee-details p{font-size:14px;line-height:1.6;margin:12px 0}
.sm-fee-list{margin:12px 0}
.sm-fee-list>div{padding:12px 0;border-bottom:1px solid var(--sm-bd)}
.sm-fee-list dt{font-size:14px;line-height:1.5}
.sm-fee-list dd{font-size:20px;font-weight:700;line-height:1.5;margin:4px 0 0}
.sm-fee-list small{display:block;font-size:12px;font-weight:400;line-height:1.5}
</style>

<script is:inline>
(function(){
/* ---------- data: DWS factsheets, 30 September 2026; iFAST prospectus, 29 September 2026 ---------- */
/* fee = annual fund-level charge on the SGX line (% a year). iFAST funds use FSM Global published pre-launch TER figures:
   https://fsm.global/sg/article/rcms397520 (no component reconciliation supplied).
   Korea/Taiwan data: 29 September 2026. Japan/AI data: 30 September 2026:
   https://fsm.global/sg/article/rcms397041 and https://fsm.global/sg/article/rcms397262.
   All treated as estimates; do not add the underlying fee again.
   over = the same fund bought overseas (the Xtrackers class itself) and its fee. */
const FUNDS = [
  { code:'XUS', name:'S&P 500', fee:0.03, est:false, over:{ label:'Same fund in London, in US$', fee:0.03 },
    h:{ 'Nvidia':8.35, 'Apple':7.44, 'Microsoft':5.70, 'Amazon':3.64, 'Alphabet':5.46, 'Broadcom':2.51, 'Meta':2.38, 'Micron':1.79, 'Tesla':1.52 } },
  { code:'XND', name:'Nasdaq-100', fee:0.20, est:false, over:{ label:'Same fund in London, in US$', fee:0.20 },
    h:{ 'Nvidia':8.41, 'Apple':7.53, 'Microsoft':5.76, 'Micron':5.01, 'AMD':4.18, 'Amazon':4.05, 'Meta':3.24, 'Alphabet':5.93, 'Tesla':2.86 } },
  { code:'XWR', name:'MSCI World', fee:0.12, est:false, over:{ label:'Same fund in London, in US$', fee:0.12 },
    h:{ 'Nvidia':5.77, 'Apple':5.46, 'Microsoft':3.94, 'Amazon':2.62, 'Alphabet':3.95, 'Broadcom':1.73, 'Meta':1.73, 'Micron':1.31, 'Tesla':1.12 } },
  { code:'EUS', name:'S&P 500 Equal Weight', fee:0.15, est:false, over:{ label:'Same fund in London, in US$', fee:0.15 }, approx:true,
    h:{ 'Nvidia':0.2, 'Apple':0.2, 'Microsoft':0.2, 'Amazon':0.2, 'Alphabet':0.2, 'Meta':0.2, 'Micron':0.2, 'Broadcom':0.2, 'Tesla':0.2, 'AMD':0.2, 'Walmart':0.2, 'Moderna':0.30 } },
  { code:'XBG', name:'AI & Big Data (held through iFAST)', fee:0.63, est:true, over:{ label:'Xtrackers AI & Big Data in London, in US$', fee:0.35 },
    h:{ 'Microsoft':5.75, 'Meta':5.35, 'Apple':4.93, 'Nvidia':4.82, 'AMD':4.41, 'Amazon':4.35, 'Walmart':4.04, 'Alphabet':4.04, 'Samsung Electronics':3.86, 'Micron':3.85 } },
  { code:'JPY', name:'Nikkei 225 (held through iFAST)', fee:0.43, est:true, over:{ label:'Xtrackers Nikkei 225 in Frankfurt, in euro', fee:0.09 },
    h:{ 'Advantest':12.34, 'Tokyo Electron':8.59, 'Fast Retailing':8.28, 'SoftBank Group':7.62, 'Recruit':2.51, 'Ibiden':2.27, 'TDK':2.25, 'Kioxia':1.90, 'KDDI':1.82, 'Fujikura':1.51 } },
  { code:'KOR', name:'MSCI Korea (held through iFAST)', fee:0.67, est:true, over:{ label:'Xtrackers MSCI Korea in London, in US$', fee:0.45 },
    h:{ 'Samsung Electronics':31.98, 'SK hynix':17.90, 'SK Square':4.30, 'Samsung Electro-Mechanics':3.55, 'KB Financial':2.48, 'Hyundai Motor':2.00, 'Shinhan Financial':1.96, 'Doosan Enerbility':1.56, 'Hana Financial':1.53 } },
  { code:'TWD', name:'MSCI Taiwan (held through iFAST)', fee:0.77, est:true, over:{ label:'Xtrackers MSCI Taiwan in London, in US$', fee:0.65 },
    h:{ 'TSMC':30.23, 'MediaTek':10.04, 'Delta Electronics':4.90, 'Hon Hai':4.05, 'ASE':3.08, 'UMC':2.29, 'Unimicron':2.11, 'Elite Material':1.91, 'Fubon Financial':1.66, 'Asia Vital Components':1.52 } },
];
const FIVE = ['Nvidia','Apple','Microsoft','Amazon','Alphabet'];
const $ = id => document.getElementById(id);
const numOf = el => { const n = parseFloat(String(el.value).replace(/[^\d.\-]/g,'')); return isFinite(n) && n >= 0 ? n : 0; };
const sgd = n => 'S$' + Math.round(n).toLocaleString('en-SG');
const pct2 = n => n.toFixed(2) + '%';
const pct1 = n => n.toFixed(1) + '%';
/* ---------- tabs ---------- */
function showTab(which){
  const own = which === 'own';
  $('sm-tab-own').setAttribute('aria-selected', String(own));
  $('sm-tab-cost').setAttribute('aria-selected', String(!own));
  $('sm-own').hidden = !own; $('sm-cost').hidden = own;
}

/* ---------- What you own ---------- */
function buildOwnTable(){
  $('sm-own-tbl').querySelector('tbody').innerHTML = FUNDS.map(f =>
    '<tr><td>' + f.code + '<em>' + f.name + '</em><em>' + (f.est ? 'iFAST: extra fund layer' : 'Direct listing: one fund') + '</em></td>'
    + '<td class="num">' + pct2(f.fee) + (f.est ? '<em>' + 'publisher estimate' + '</em>' : '') + '</td>'
    + '<td><input type="text" id="sm-a-' + f.code + '" value="1,000" inputmode="decimal" aria-label="Amount in ' + f.code + '"></td></tr>'
  ).join('');
}

function updateOwn(){
  const amts = FUNDS.map(f => numOf($('sm-a-' + f.code)));
  const total = amts.reduce((a,b) => a+b, 0);
  if (total <= 0){
    $('sm-own-bars').innerHTML = ''; $('sm-own-t').textContent = '—';
    $('sm-own-say').textContent = 'Enter an amount in at least one line.';
    return;
  }
  const look = {};
  FUNDS.forEach((f,i) => { for (const [c,w] of Object.entries(f.h)) look[c] = (look[c]||0) + amts[i]*w/100; });
  const rows = Object.entries(look).map(([c,v]) => ({ c, v, p: v/total*100 }))
    .filter(r => r.v > 0).sort((a,b) => b.v - a.v).slice(0, 10);
  const five = FIVE.reduce((s,c) => s + (look[c]||0), 0);
  const fee = FUNDS.reduce((s,f,i) => s + amts[i]*f.fee/100, 0);
  const max = rows.length ? rows[0].p : 1;
  const approxOn = amts[FUNDS.findIndex(f => f.code === 'EUS')] > 0;

  $('sm-own-t').innerHTML = 'Your <b>' + sgd(total) + '</b> across ' + amts.filter(a => a>0).length + ' line' + (amts.filter(a=>a>0).length===1?'':'s') + ': the ten companies you hold most of';
  $('sm-own-bars').innerHTML = rows.map(r =>
    '<div class="sm-bar"><div class="sm-bar-l"><span>' + r.c + '</span><b class="num">' + pct1(r.p)
    + '<i class="sm-tc">' + sgd(r.v) + '</i></b></div>'
    + '<div class="sm-track"><div class="sm-fill" style="width:' + Math.max(2, Math.min(100, r.p/max*100)) + '%"></div></div></div>'
  ).join('');
  $('sm-own-say').innerHTML = 'Nvidia, Apple, Microsoft, Amazon and Alphabet together: <b>' + pct1(five/total*100) + '</b> of your total, or <b>' + sgd(five) + '</b>. '
    + 'Published annual fund-fee estimate across your mix: <b>' + pct2(fee/total*100) + '</b> a year, about <b>' + sgd(fee) + '</b>.'
    + ' This excludes other costs and taxes. Only each fund&rsquo;s published top ten holdings are counted, so the true figures can be slightly higher.'
    + (approxOn ? ' The equal-weight fund&rsquo;s US names are taken at about 0.2% each.' : '');
}

/* ---------- Disclosed fees and practical access ---------- */
function updateFees(){
  const f = FUNDS.find(x => x.code === $('sm-exp').value);
  const localBasis = f.est ? 'Publisher TER estimate, not an audited actual or cap' : 'Published fund fee';
  const structure = f.est
    ? 'The SGX investment is an iFAST fund holding the overseas Xtrackers fund. Its published TER already represents the estimated fund-expense total; do not add the underlying fee again.'
    : 'These are listings of the same fund share class. The portfolio and internal fund costs are shared; the exchange listing changes how you trade it.';
  $('sm-fee-details').innerHTML =
    '<h3>' + f.name + '</h3>'
    + '<dl class="sm-fee-list"><div><dt>SGX listing: annual fund charge</dt><dd>' + pct2(f.fee) + '<small>' + localBasis + '</small></dd></div>'
    + '<div><dt>' + f.over.label + ': annual fund charge</dt><dd>' + pct2(f.over.fee) + '<small>Published fund fee</small></dd></div></dl>'
    + '<p><b>' + (f.est ? 'Two fund layers; use the estimated total once.' : 'One fund; no extra Singapore fund fee.') + '</b> ' + structure + '</p>'
    + '<p><b>What this means:</b> ' + (f.est
      ? 'This adds local access to a specific country or theme. The extra fund layer may be useful when overseas access is unavailable or local account access matters. A lower-fee World or US fund buys a different portfolio.'
      : 'This is a simpler fund structure with lower stated annual fees than the four iFAST funds in this article. It only fits the comparison if this is the market exposure you want; it does not replace a specific Japan, Korea, Taiwan or AI allocation.') + '</p>'
    + '<p><b>SGX access:</b> Singapore trading hours and payment in Singapore dollars. SRS access is subject to your operator enabling the counter. A separate broker conversion may be avoided, but currency risk and embedded dealing costs remain.</p>'
    + '<p><b>Overseas access:</b> requires access to that exchange and its trading hours, plus foreign-currency funding. Broker conversion and account charges vary. These overseas listings are not available with SRS money.</p>'
    + '<p><b>Compare before dealing:</b> the live buy/sell gap, order size, commission and minimum, exchange charges, currency terms and custody fees. Published fund fees alone do not identify the cheaper route.</p>';
}

/* Keep legacy tab=cost links usable; obsolete amount/year inputs are ignored. */
function writeLink(){
  try {
    const p = new URLSearchParams(window.location.search);
    p.set('tab', $('sm-own').hidden ? 'cost' : 'own');
    p.set('exp', $('sm-exp').value);
    p.delete('amt'); p.delete('yrs');
    history.replaceState(null, '', window.location.pathname + '?' + p.toString() + window.location.hash);
  } catch(err){}
}
function readLink(){
  try {
    const p = new URLSearchParams(window.location.search);
    if (FUNDS.some(f => f.code === p.get('exp'))) $('sm-exp').value = p.get('exp');
    if (p.get('tab') === 'cost') showTab('cost');
  } catch(err){}
}
function init(){
  buildOwnTable();
  FUNDS.forEach(f => $('sm-a-' + f.code).addEventListener('input', updateOwn));
  readLink();
  $('sm-tab-own').addEventListener('click', () => { showTab('own'); writeLink(); });
  $('sm-tab-cost').addEventListener('click', () => { showTab('cost'); writeLink(); });
  $('sm-exp').addEventListener('change', () => { updateFees(); writeLink(); });
  updateOwn(); updateFees();
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
})();
</script>
