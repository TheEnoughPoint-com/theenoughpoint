---
// Standard right-column sidebar: Popular Reads → Our Tools → Newsletter → Disclosure.
// Used on the homepage and article pages. Page-specific widgets (e.g. TagsWidget,
// CategoryWidget) are appended as siblings by the caller, or via the default slot.
// Partner Offers (RecommendedTools) is temporarily removed from this sidebar —
// still used standalone in the homepage's "Recommended Platforms" strip.
import NewsletterBox from './NewsletterBox.astro';
import TopViewedArticles from './TopViewedArticles.astro';
import ToolsWidget from './ToolsWidget.astro';
import AffiliateDisclosureBox from './AffiliateDisclosureBox.astro';
import TikTokEmbed from './TikTokEmbed.astro';
import type { InferEntrySchema } from 'astro:content';

interface Props {
  showNewsletter?: boolean;
  showDisclosure?: boolean;
  tiktokEmbed?: InferEntrySchema<'blog'>['tiktokEmbed'];
}

const { showNewsletter = true, showDisclosure = true, tiktokEmbed } = Astro.props;
---

<div class="flex flex-col gap-6">
  {tiktokEmbed && <TikTokEmbed {...tiktokEmbed} />}
  <TopViewedArticles />
  <ToolsWidget />
  {showNewsletter && <NewsletterBox />}
  {showDisclosure && <AffiliateDisclosureBox />}
  <slot />
</div>
