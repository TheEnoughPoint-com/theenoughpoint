  .fee-map p{font-size:14px;line-height:1.55;margin:12px 0 0}
  .fee-map .fee-map-name{margin-top:6px}
  .fee-map-total{margin-top:18px;padding:16px;border:1px solid var(--color-muted);border-radius:6px}
  .fee-map-total>b{display:block;font-size:28px;line-height:1.3;color:var(--color-dark);margin:5px 0}
  .fee-map-total>span{display:block;font-size:14px;line-height:1.5}
  .fee-map .fee-map-label{display:block;font-size:12px;font-weight:400;line-height:1.5;color:var(--color-body);margin-top:3px}
  .fee-map-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:20px}
  .fee-map section{min-width:0}
