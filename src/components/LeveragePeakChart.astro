---
// The peak divergence, drawn.
//
// Both series plotted as PERCENTAGE CHANGE from 1 May 2026, on a shared zero
// baseline. Two reasons. First, "+110%" is legible on sight where an index value
// of 210 asks the reader to remember the base and subtract. Second, one axis:
// the idea for this piece came from a chart with the 3x fund on the left axis
// and the index on the right, and a dual-axis chart makes two lines say whatever
// the scaling chose. A shared zero is the honest version.
//
// Window chosen deliberately: May to July 2026, around the peak. Over the longer
// 2024-26 run the 3x fund outperformed, so a chart of that period would argue the
// opposite of the article. This shows the mechanism, not a verdict.
//
// Daily adjusted closes, split-adjusted, from a free public price API. Values are
// the historical record; nothing is modelled. Stored as index-to-100 and converted
// below, so the raw series stays checkable against the source.
const LEV = [100.0,103.2,121.4,139.2,127.5,156.3,163.1,126.3,148.3,152.6,124.7,118.4,114.5,126.2,139.2,129.5,168.4,162.4,182.5,180.9,209.9,203.2,198.6,174.2,101.2,117.7,114.8,104.4,139.7,136.9,165.8,152.5,151.7,181.0,180.6,116.1,123.0,137.6,122.5,122.5,129.6,99.6,89.8,103.6,90.4,91.8,94.6,92.4,69.6,79.9,72.6,61.9,60.6,61.1,72.1,68.9,73.0,59.2,57.1,47.0,40.1,54.0,49.7];
const IDX = [100.0,101.0,107.1,112.3,109.1,117.4,119.0,110.2,116.4,117.6,110.4,108.7,107.4,111.2,115.1,112.4,123.9,122.4,127.4,127.1,133.8,132.4,131.5,125.9,108.1,114.6,113.6,110.2,122.8,121.9,130.5,127.1,126.6,135.3,135.2,118.6,121.8,126.5,121.8,121.9,124.6,114.5,111.2,117.2,111.9,112.8,114.0,113.3,103.7,109.2,106.0,100.8,100.3,100.5,106.7,105.2,107.3,100.6,99.5,93.5,89.0,99.5,97.0];

const lev = LEV.map((v) => v - 100);
const idx = IDX.map((v) => v - 100);

const W = 700, H = 300, PAD_L = 42, PAD_R = 78, PAD_T = 44, PAD_B = 28;
const LO = -62, HI = 118;
const n = lev.length;
const x = (i: number) => PAD_L + (i / (n - 1)) * (W - PAD_L - PAD_R);
const y = (v: number) => PAD_T + (1 - (v - LO) / (HI - LO)) * (H - PAD_T - PAD_B);
const path = (a: number[]) => a.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');

const LP = 20, IP = 33;                        // 1 June and 18 June 2026
const TICKS = [{ i: 0, t: 'May' }, { i: 20, t: 'Jun' }, { i: 41, t: 'Jul' }];
const GRID = [100, 50, 0, -50];
const sign = (v: number) => (v > 0 ? '+' : '') + Math.round(v) + '%';
---

<figure class="pk">
  <figcaption class="pk-cap">
    <h4>The index fell 3%. The 3&times; fund fell 50%.</h4>
    <p>1 May to 31 July 2026, Korea. The 3&times; fund against the index it tracks, both on the
    same scale.</p>
  </figcaption>

  <div class="pk-wrap">
    <svg viewBox={`0 0 ${W} ${H}`} class="pk-svg" role="img"
         aria-label="Percentage change since 1 May 2026. The 3x fund climbs to +110% on 1 June then falls to -50% by 31 July. The index peaks later, at +35% on 18 June, and ends near -3%.">
      {GRID.map((g) => (
        <>
          <line x1={PAD_L} x2={W - PAD_R} y1={y(g)} y2={y(g)} class={g === 0 ? 'pk-zero' : 'pk-grid'} />
          <text x={PAD_L - 8} y={y(g) + 3.5} class="pk-ylab">{sign(g)}</text>
        </>
      ))}
      {TICKS.map((t) => <text x={x(t.i)} y={H - 9} class="pk-xlab">{t.t}</text>)}

      <line x1={x(LP)} x2={x(IP)} y1={22} y2={22} class="pk-span" />
      <line x1={x(LP)} x2={x(LP)} y1={17} y2={27} class="pk-span" />
      <line x1={x(IP)} x2={x(IP)} y1={17} y2={27} class="pk-span" />
      <text x={(x(LP) + x(IP)) / 2} y={13} class="pk-spanlab">17 days</text>

      <path d={path(idx)} class="pk-line idx" />
      <path d={path(lev)} class="pk-line lev" />

      <line x1={x(LP)} x2={x(LP)} y1={y(lev[LP])} y2={y(0)} class="pk-drop lev" />
      <line x1={x(IP)} x2={x(IP)} y1={y(idx[IP])} y2={y(0)} class="pk-drop idx" />

      <circle cx={x(LP)} cy={y(lev[LP])} r="5" class="pk-dot lev" />
      <circle cx={x(IP)} cy={y(idx[IP])} r="5" class="pk-dot idx" />

      <text x={x(LP) - 9} y={y(lev[LP]) - 9} class="pk-peak lev">3&times; fund peaks 1 Jun</text>
      <text x={x(IP) + 10} y={y(idx[IP]) - 9} class="pk-peak idx">index peaks 18 Jun</text>

      <text x={W - PAD_R + 7} y={y(lev[n - 1]) - 5} class="pk-end lev">3&times; fund</text>
      <text x={W - PAD_R + 7} y={y(lev[n - 1]) + 15} class="pk-endval lev">{sign(lev[n - 1])}</text>
      <text x={W - PAD_R + 7} y={y(idx[n - 1]) - 5} class="pk-end idx">the index</text>
      <text x={W - PAD_R + 7} y={y(idx[n - 1]) + 15} class="pk-endval idx">{sign(idx[n - 1])}</text>
    </svg>
  </div>

  <p class="pk-foot">Three times a 3% fall is a <b>9%</b> fall. Holders of the 3&times; fund lost <b>50%</b> &mdash; roughly <b>sixteen times</b> the index&rsquo;s loss, not three. The multiple on the label describes a single day; over three months it described nothing that happened.</p>

  <p class="pk-note">It also topped out on <b>1 June</b>, seventeen days before the index peaked on <b>18 June</b>: over that stretch the index rose a further 1.2% while the fund lost 13.8%, falling while the market it tracks was still setting highs.</p>
</figure>

<style is:global>
.pk{
  --pk-idx:#1A8754; --pk-lev:#2563EB;
  --pk-rule:var(--color-border); --pk-ink:var(--color-dark);
  --pk-body:var(--color-body); --pk-muted:var(--color-muted);
  --pk-mono:var(--font-mono),'SF Mono',Menlo,Consolas,monospace;
  margin:26px 0;padding:20px 22px 16px;background:#fff;
  border:1px solid var(--pk-rule);border-radius:12px
}
/* No dark-scheme colour swap. The card sets background:#fff unconditionally,
   so a dark-mode block that lightens the ink puts pale text on a white card.
   The pair this replaced measured 3.00:1 and 3.63:1 there. Every colour here
   is measured against white — #1A8754 4.53:1, #2563EB 5.17:1 — and stays put. */
.post-content .pk-cap{margin:0 0 12px;padding:0;text-align:left}
.post-content .pk-cap h4{margin:0 0 3px;font-size:15.5px;font-weight:700;color:var(--pk-ink);
  font-family:var(--font-body);letter-spacing:0}
.post-content .pk-cap p{margin:0;font-size:12.5px;color:var(--pk-muted);line-height:1.5}
.pk-wrap{overflow-x:auto}
.pk-svg{width:100%;min-width:480px;height:auto;display:block}
.pk-grid{stroke:var(--pk-rule);stroke-width:1}
.pk-zero{stroke:var(--pk-muted);stroke-width:1.25;opacity:.55}
.pk-ylab,.pk-xlab{font-family:var(--pk-mono);font-size:10px;fill:var(--pk-muted)}
.pk-ylab{text-anchor:end}
.pk-xlab{text-anchor:middle}
.pk-line{fill:none;stroke-width:2.25;stroke-linejoin:round;stroke-linecap:round}
.pk-line.idx{stroke:var(--pk-idx)}
.pk-line.lev{stroke:var(--pk-lev)}
.pk-span{stroke:var(--pk-muted);stroke-width:1;opacity:.7}
.pk-spanlab{font-family:var(--font-body);font-size:11px;font-weight:700;fill:var(--pk-muted);
  text-anchor:middle;letter-spacing:.02em}
.pk-drop{stroke-width:1;stroke-dasharray:2 3;opacity:.5}
.pk-drop.idx{stroke:var(--pk-idx)}
.pk-drop.lev{stroke:var(--pk-lev)}
/* The halo is white because the card is white. The navy override that sat here
   drew a dark ring on that white card in dark mode, not against a dark one. */
.pk-dot{stroke:#fff;stroke-width:2}
.pk-dot.idx{fill:var(--pk-idx)}
.pk-dot.lev{fill:var(--pk-lev)}
.pk-peak{font-family:var(--font-body);font-size:11px;font-weight:600}
.pk-peak.lev{fill:var(--pk-lev);text-anchor:end}
.pk-peak.idx{fill:var(--pk-idx);text-anchor:start}
.pk-end{font-family:var(--font-body);font-size:11.5px;font-weight:700;text-anchor:start}
.pk-end.idx{fill:var(--pk-idx)}
.pk-end.lev{fill:var(--pk-lev)}
.pk-endval{font-family:var(--pk-mono);font-size:12.5px;font-weight:600;text-anchor:start}
.pk-endval.idx{fill:var(--pk-idx)}
.pk-endval.lev{fill:var(--pk-lev)}
.post-content .pk-note{font-size:11.5px;color:var(--pk-muted);line-height:1.55;margin:9px 0 0}
.pk-note b{font-family:var(--pk-mono);color:var(--pk-body);font-weight:600}
.post-content .pk-foot{font-size:13px;color:var(--pk-body);line-height:1.55;margin:10px 0 0}
.pk-foot b{font-family:var(--pk-mono);color:var(--pk-ink)}
@media(max-width:560px){ .pk{padding:16px 14px 13px} }
</style>
